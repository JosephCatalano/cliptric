{
	admin off
	auto_https disable_redirects
}

https://cliptric.com {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}

	header {
		Cache-Control "private, no-store"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		defer
	}

	@public {
		method GET HEAD
		path / /about /privacy /terms /data-deletion /favicon.ico /icon.png /_next/static/*
	}
	handle @public {
		@home path /
		redir @home /about 302
		handle_path /_next/static/* {
			root * .next/static
			file_server
		}
		handle {
			reverse_proxy 127.0.0.1:3000 {
				header_up -Authorization
				header_up -X-Cliptric-Gateway
			}
		}
	}

	handle {
		basic_auth {
			cliptric {$CLIPPING_PASSWORD_HASH}
		}
		handle /api/import {
			reverse_proxy 127.0.0.1:3000 {
				header_up -Authorization
				header_up X-Cliptric-Gateway {$CLIPPING_GATEWAY_TOKEN}
			}
		}
		handle /api/* {
			reverse_proxy 127.0.0.1:8765 {
				header_up -Authorization
				header_up X-Cliptric-Gateway {$CLIPPING_GATEWAY_TOKEN}
			}
		}
		handle {
			reverse_proxy 127.0.0.1:3000 {
				header_up -Authorization
				header_up -X-Cliptric-Gateway
			}
		}
	}
}
